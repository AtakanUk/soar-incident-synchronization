MSSP_SOAR_HOST=soar-mssp.example.com
MSSP_SOAR_PORT=443
MSSP_SOAR_ORG=Example MSSP
MSSP_SOAR_API_KEY_ID=your-mssp-api-key-id
MSSP_SOAR_API_KEY_SECRET=your-mssp-api-key-secret
# true = verify with system CAs, false = no verification, or a CA bundle path
MSSP_SOAR_CAFILE=true

CUSTOMER_SOAR_HOST=soar-customer.example.com
CUSTOMER_SOAR_PORT=443
CUSTOMER_SOAR_ORG=Example Customer
CUSTOMER_SOAR_API_KEY_ID=your-customer-api-key-id
CUSTOMER_SOAR_API_KEY_SECRET=your-customer-api-key-secret
CUSTOMER_SOAR_CAFILE=true

SOAR_SYNC_MSSP_REFERENCE_FIELD=mssp_incident_id
SOAR_SYNC_CUSTOMER_REFERENCE_FIELD=customer_incident_id
SOAR_SYNC_CUSTOMER_RESOLUTION_FIELD=customer_resolution
SOAR_SYNC_REPORT_DESCRIPTION_FIELD=describe_the_incident
SOAR_SYNC_REPORT_RECOMMENDATION_FIELD=provide_recommendation
SOAR_SYNC_REPORT_DATE_FIELD=date_reported
SOAR_SYNC_ANALYST_FIELD=analyst
SOAR_SYNC_ANALYST_ASSIGNED_FIELD=analyst_assigned
SOAR_SYNC_COPY_PROPERTY_FIELDS=external_alert_id,date_reported
SOAR_SYNC_MSSP_DESCRIPTION_TASK=Describe the offense.
SOAR_SYNC_MSSP_RECOMMENDATION_TASK=Provide suggestions.
SOAR_SYNC_CUSTOMER_CREATE_PROPERTIES_JSON={"is_event_record":"yes","recommended_actions":["review-alert"],"report_date":null}
SOAR_SYNC_MSSP_CREATE_PROPERTIES_JSON={"action_needed":"triage","false_positive":"no"}
# Corrections where option labels differ, per direction: {"customer-to-mssp": {"customer_resolution->resolution_id": {"897": 19433}}}
SOAR_SYNC_OVERRIDE_MAPS_JSON={}

SOAR_SYNC_MIGRATION_TRACKING_FIELD=source_incident_id
SOAR_SYNC_MIGRATION_DEFAULT_RESOLUTION=
SOAR_SYNC_MIGRATION_DEFAULT_RESOLUTION_SUMMARY=Migrated from the previous SOAR instance.
SOAR_SYNC_TEST_INCIDENT_MARKER=Incident generated

SOAR_SYNC_LOG_DIR=logs
SOAR_SYNC_LOG_LEVEL=INFO

SOAR_SYNC_ERROR_MAIL_ENABLED=false
SOAR_SYNC_ERROR_MAIL_TO=alerts-mailbox
SOAR_SYNC_ERROR_MAIL_FROM=soar-sync-mailbox
SOAR_SYNC_ERROR_MAIL_SMTP_USER=soar-sync-mailbox
SOAR_SYNC_ERROR_MAIL_SMTP_SERVER=smtp.office365.com
SOAR_SYNC_ERROR_MAIL_SMTP_PORT=587
SOAR_SYNC_ERROR_MAIL_OAUTH_CLIENT_ID=your-client-id
SOAR_SYNC_ERROR_MAIL_OAUTH_CLIENT_SECRET=your-client-secret
SOAR_SYNC_ERROR_MAIL_OAUTH_TENANT_ID=your-tenant-id
SOAR_SYNC_ERROR_MAIL_OAUTH_REFRESH_TOKEN=your-refresh-token
SOAR_SYNC_ERROR_MAIL_OAUTH_SCOPE=offline_access https://outlook.office365.com/SMTP.Send
